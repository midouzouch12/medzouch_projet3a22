
{% extends 'base.html.twig' %}

{% block title %}Hello BookController!{% endblock %}

{% block body %}
  <style>
    .example-wrapper {
      margin: 1em auto;
      max-width: 800px;
      width: 95%;
      font: 18px/1.5 sans-serif;
    }
    .example-wrapper code {
      background: #F5F5F5;
      padding: 2px 6px;
    }
  </style>

  <div class="example-wrapper">
<h1>Add Book</h1>
{# {{form(f)}} #}
  <div class="example-wrapper">
{#{{form(f)}}#}


{{form_start(f)}}
{{form_label(f.title,"Titre du livre :")}}
{{form_widget(f.title,{'attr':{'class':'form-control'}})}}
{{form_label(f.publicationDate,"Date de publication :")}}
{{form_widget(f.publicationDate,{'attr':{'class':'form-control'}})}}
{{form_label(f.enabled,"Activé :")}}
{{form_widget(f.enabled,{'attr':{'class':'form-check-input'}})}}
{{form_label(f.published,"Publié :")}}
{{form_widget(f.published,{'attr':{'class':'form-check-input'}})}}
{{form_label(f.category,"Catégorie :")}}
{{form_widget(f.category,{'attr':{'class':'form-control'}})}}
{{form_label(f.author_book,"Auteur :")}}
{{form_widget(f.author_book,{'attr':{'class':'form-control'}})}}
{{form_widget(f.submit,{'attr':{'class':'btn btn-primary'}})}}
{{form_end(f)}}


  </div>
  {% endblock %}
