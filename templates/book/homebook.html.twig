{% extends 'base.html.twig' %}

{% block title %}Liste des Livres{% endblock %}

{% block body %}
  <style>
    .example-wrapper {
      margin: 1.5em auto;
      max-width: 90%;
      font-family: 'Arial', sans-serif;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
      padding: 20px;
      background-color: #ffffff;
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
      color: #343a40;
    }

    .table {
      width: 100%;
      margin-top: 20px;
      border-radius: 8px;
      overflow: hidden;
      border-collapse: collapse;
    }

    .table th, .table td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid #dee2e6;
      transition: background-color 0.3s;
    }

    .table th {
      background-color: #495057;
      color: white;
      text-transform: uppercase;
      font-size: 14px;
    }

    .table tr:nth-child(even) {
      background-color: #f2f2f2;
    }

    .table tr:hover {
      background-color: #e1f5fe;
    }

    .btn {
      font-size: 14px;
      margin-right: 5px;
      border-radius: 5px;
    }

    .btn-outline-primary {
      border-color: #007bff;
      color: #007bff;
    }

    .btn-outline-danger {
      border-color: #dc3545;
      color: #dc3545;
    }

    .btn-outline-success {
      border-color: #28a745;
      color: #28a745;
    }

    .btn-add {
      margin-top: 20px;
      text-align: center;
    }

    .alert {
      margin-top: 10px;
      text-align: center;
    }
  </style>


    
    <h1 class="text-center mb-4">Liste des Livres Publiés</h1>
    
        <div class="row">
            <div class="col-12">
                <h2 class="mb-3">Livres Disponibles</h2>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Titre</th>
                                <th>Catégorie</th>
                                <th>Date de Publication</th>
                                <th>Auteur</th>
                                <th>Email Auteur</th>
                                <th>Activé</th>
                                <th>Publié</th>
                                <th colspan="2" style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for book in publishedBooks %}
                                <tr>
                                    <td>{{ book.title }}</td>
                                    <td>
                                        <span class="badge bg-primary">{{ book.category }}</span>
                                    </td>
                                    <td>{{ book.publicationDate ? book.publicationDate|date('d/m/Y') : 'N/A' }}</td>
                                    <td>{{ book.authorBook ? book.authorBook.Username : 'N/A' }}</td>
                                    <td>{{ book.authorBook ? book.authorBook.Email : 'N/A' }}</td>
                                    <td>
                                        {% if book.enabled %}
                                            <span class="badge bg-success">Oui</span>
                                        {% else %}
                                            <span class="badge bg-danger">Non</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if book.published %}
                                            <span class="badge bg-success">Publié</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Non publié</span>
                                        {% endif %}
                                    </td>
                                    <td style="text-align: center;">
                                 <a class="btn btn-outline-primary" href="{{ path('app_book_update', { id: book.id }) }}">Update</a>
                                    </td>
                                <td style="text-align: center;">
                                 <a class="btn btn-outline-danger" href="{{ path('app_book_delete', { id: book.id }) }}">Remove</a>
                                </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>

                
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card text-white bg-success">
                <div class="card-body text-center">
                    <h5 class="card-title">Livres Publiés</h5>
                    <p class="card-text display-4">{{ publishedCount }}</p>
                </div>
            </div>
        </div>
        <div class="container mt-4">
        <div class="col-md-6">
            <div class="card text-white bg-warning">
                <div class="card-body text-center">
                    <h5 class="card-title">Livres Non Publiés</h5>
                    <p class="card-text display-4">{{ unpublishedCount }}</p>
                </div>
            </div>
        </div>
    </div>

    
                </div>
            </div>
        </div>
    
        
    <div class="text-center mt-4">
        <a href="{{ path('add_book') }}" class="btn btn-primary btn-lg">
            <i class="fas fa-plus"></i> Ajouter un Nouveau Livre
        </a>
    </div>
</div>
{% endblock %}